{
  "name": "gastos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Gestion de gastos domesticos para uso familiar",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"magenta,cyan\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --watch-path=server/index.js --watch-path=server/db --watch-path=server/lib --watch-path=server/routes --watch-path=server/services server/index.js",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "typecheck": "tsc -b --noEmit",
    "test": "node pruebas/ejecutar.mjs",
    "copia-bd": "node pruebas/copia-bd.mjs",
    "iconos": "node scripts/generar-iconos.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "playwright": "^1.49.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
